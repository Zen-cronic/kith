# Copy to .env (gitignored). Keys are read from the environment only; never pass them as CLI arguments.

# Which model host runs the Strands agents.
#   auto      = anthropic if ANTHROPIC_API_KEY is set, else openai if OPENAI_API_KEY is set, else fake (default)
#   fake      = deterministic demo mode (no network, no keys)
#   bedrock   = chosen explicitly; needs model access granted in the account
MODEL_PROVIDER=auto            # auto | fake | anthropic | openai | bedrock

# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_ID=claude-opus-5          # or claude-sonnet-5 (cheaper); exact IDs, no date suffix

# MODEL_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL_ID=gpt-5                       # set to a model your account can use

# MODEL_PROVIDER=bedrock (production target; needs working AWS credentials + model access in AWS_REGION)
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=                          # leave unset to let Strands pick its regional default; needs model access granted

# Speech (browser Web Speech API is the default; Polly/Transcribe only when AWS credentials work)
# SPEECH_PROVIDER=browser      # browser | aws

# Maximum model requests per document run, shared by all agents and back-translation.
# Positive integer; failed attempts and Strands retries count. Not a dollar/token limit.
MAX_MODEL_CALLS=20

# Web session execution; local keeps the existing in-process graph.
SESSION_BACKEND=local          # local | runtime-http | agentcore
# Local container/service development:
# RUNTIME_HTTP_URL=http://127.0.0.1:8080
# IAM-authenticated AgentCore deployment (server environment only):
# HOUSEHOLD_RUNTIME_ARN=
# HOUSEHOLD_RUNTIME_QUALIFIER=DEFAULT
# Remote Runtime must have AGENTCORE_MEMORY_ID unset; review consent after config changes.

# household additions
EXECUTION_MODE=simulated          # simulated | live  (live = real SES send / real ledger posts)
NODE_MODELS=                       # e.g. intake=bedrock:us.amazon.nova-pro-v1:0,planner=anthropic:claude-sonnet-5
SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
SONIC_VOICE=matthew
SPEECH=on                          # off = text fallback only (CI)
SES_FROM=                          # a verified SES identity in us-east-1 (sandbox: also the only allowed recipient)
HOUSEHOLD_STORE=json               # json | dynamo
AEROAPI_KEY=
STRIPE_SECRET_KEY=
