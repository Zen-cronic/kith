# Public demo image: serves the Kith web UI in deterministic fake mode (no model keys, no AWS calls).
FROM python:3.12-slim@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea

RUN apt-get update && apt-get install -y --no-install-recommends pipx \
    && rm -rf /var/lib/apt/lists/*
ENV PIPX_HOME=/opt/pipx PIPX_BIN_DIR=/usr/local/bin \
    POETRY_VIRTUALENVS_CREATE=false POETRY_CACHE_DIR=/tmp/poetry-cache \
    PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pipx install --python /usr/local/bin/python poetry==2.2.1
WORKDIR /app
COPY pyproject.toml poetry.lock README.md LICENSE ./
COPY household ./household
COPY fixtures ./fixtures
RUN poetry install --only main --no-interaction --no-ansi \
    && rm -rf /tmp/poetry-cache \
    && useradd --uid 10001 --create-home household

# Demo defaults: deterministic fake provider, simulated rails, resettable, writable data dir under /tmp.
ENV MODEL_PROVIDER=fake EXECUTION_MODE=simulated HOUSEHOLD_ALLOW_RESET=1 \
    HOUSEHOLD_DATA_DIR=/tmp/household-data
USER household
EXPOSE 8080
CMD ["python", "-m", "household.cli", "serve", "--host", "0.0.0.0", "--port", "8080"]
